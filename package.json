{
  "name": "@notpdpton/dsh-net-proxy",
  "version": "0.1.0",
  "type": "module",
  "description": "让 DSH 自身的网络请求走代理。",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "proxy",
    "network"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notpdpton/dsh-net-proxy.git"
  },
  "homepage": "https://github.com/notpdpton/dsh-net-proxy#readme",
  "bugs": {
    "url": "https://github.com/notpdpton/dsh-net-proxy/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/*.md",
    "test/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
